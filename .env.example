# Copie para .env e preencha. NUNCA faça commit do .env.
NODE_ENV=production
OWNER_NAME=Joana                       # como o bot te chama

# Banco (Neon ou outro Postgres 18). Use a URL com pooler.
DATABASE_URL=postgresql://usuario:senha@host/db?sslmode=require

# Open Finance via Pluggy (MeuPluggy): app em dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=                       # ids dos itens (um por banco), separados por vírgula

# Gemini (use um projeto com faturamento ativo: no plano gratuito o Google pode usar os dados)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=512             # mínimo de raciocínio; 0 desliga (não recomendado)

# Google Calendar (OAuth, escopo calendar.events)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# WhatsApp (Baileys): número do DONO, que pode falar com o bot
WHATSAPP_OWNER_NUMBER=5511999999999
WHATSAPP_OWNER_LID=                    # opcional: aparece no log na 1ª mensagem
WA_SESSION_DIR=./wa-session

# Telegram: recebe o QR de pareamento do WhatsApp e serve de reserva para os avisos
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

LOG_LEVEL=info
